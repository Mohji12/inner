# Copy to config.env and fill in (config.env is gitignored).
# Usage:  .\scripts\deploy\deploy-all.ps1

# --- Frontend (AWS Amplify manual zip hosting) ---
# Staging Amplify for mijnlevenspad (AWS account 497645775287, region ap-south-1).
# deploy-frontend.ps1 sets AWS_DEFAULT_REGION from AMPLIFY_REGION automatically.
AMPLIFY_APP_ID=
AMPLIFY_BRANCH=staging
AMPLIFY_REGION=ap-south-1
# Baked into the Vite build (browser calls this host for API)
VITE_API_URL=https://life.mijnlevenspad.com

# --- Backend (EC2 behind nginx) ---
EC2_HOST=life.mijnlevenspad.com
EC2_USER=ubuntu
# OpenSSH PEM (or set EC2_PPK_KEY to auto-convert)
EC2_SSH_KEY=
EC2_PPK_KEY=
# Leave blank to probe on first SSH, or set once known:
EC2_REMOTE_DIR=
EC2_SYSTEMD_SERVICE=
EC2_VENV_DIR=.venv
EC2_DEPLOY_METHOD=rsync
# Comma-separated optional one-off migrate scripts under backend/scripts/
EC2_MIGRATE_SCRIPTS=

BACKEND_HEALTH_URL=https://life.mijnlevenspad.com/health
FRONTEND_HEALTH_URL=
